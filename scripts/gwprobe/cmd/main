#!/bin/bash
# 网关探针运行控制：start / stop / status。
# 退出码约定（官方规范）：0=成功/运行中，1=失败，3=status 时=未运行。
#
# 服务形态：stdlib http.server 监听 ${TRIM_APPDEST}/gwprobe.sock（AF_UNIX），
# 由飞牛统一网关按 ui/config 的 gatewaySocket 声明转发（gatewayPrefix=/app/com.test.gatewayprobe）。
PID_FILE="${TRIM_PKGVAR}/gwprobe.pid"
LOG_FILE="${TRIM_PKGVAR}/app.log"
PYTHON="$(command -v python3 || command -v python || echo /usr/bin/python3)"

status_app() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

start_app() {
    if status_app; then
        return 0
    fi
    mkdir -p "$TRIM_PKGVAR" 2>/dev/null
    # 健康检软链自愈（同 nasdeck：uninstall 会删 /app/app.py 软链，不补则 start 报 10500）
    if [ -f "${TRIM_APPDEST}/app.py" ]; then
        mkdir -p /app 2>/dev/null
        ln -sf "${TRIM_APPDEST}/app.py" /app/app.py 2>/dev/null
    fi
    cd "$TRIM_APPDEST" || {
        echo "缺少应用目录 ${TRIM_APPDEST}" > "${TRIM_TEMP_LOGFILE}"
        exit 1
    }
    GWPROBE_SOCK="${TRIM_APPDEST}/gwprobe.sock" "$PYTHON" server.py >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    # 就绪等待：socket 文件出现为准（本地 AF_UNIX，秒级）
    for _ in $(seq 1 20); do
        [ -S "${TRIM_APPDEST}/gwprobe.sock" ] && break
        kill -0 "$(head -n 1 "$PID_FILE" | tr -d '[:space:]')" 2>/dev/null || break
        sleep 0.5
    done
    if kill -0 "$(head -n 1 "$PID_FILE" | tr -d '[:space:]')" 2>/dev/null; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - gwprobe started (sock=${TRIM_APPDEST}/gwprobe.sock)" >> "$LOG_FILE"
        exit 0
    fi
    echo "gwprobe 启动失败，请查看日志: $LOG_FILE" > "${TRIM_TEMP_LOGFILE}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - gwprobe start FAILED" >> "$LOG_FILE"
    rm -f "$PID_FILE"
    exit 1
}

stop_app() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - gwprobe stopping" >> "$LOG_FILE"
    if [ ! -f "$PID_FILE" ]; then
        rm -f "${TRIM_APPDEST}/gwprobe.sock" 2>/dev/null
        return 0
    fi
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ]; then
        kill -TERM "$pid" 2>>"$LOG_FILE" || true
        local count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>>"$LOG_FILE"
    fi
    rm -f "$PID_FILE"
    rm -f "${TRIM_APPDEST}/gwprobe.sock" 2>/dev/null
}

case "$1" in
    start)  start_app ;;
    stop)   stop_app ;;
    status) status_app && exit 0 || exit 3 ;;
    *)      echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE}"; exit 1 ;;
esac
