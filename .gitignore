# 本地打包/构建暂存目录（非源码）
_app/
_rebuild/

# Python 缓存
__pycache__/

# 本地自测虚拟环境
.venv/
venv313/

# 运行时日志
debug.log

# 本地起服务自测时生成的历史趋势库（运行时数据，非源码）
history.db

# 本地打包中间产物（app.tgz 由打包脚本重新生成，不入库）
app.tgz

# FPK 打包工作区（staging/工具/fpk 产物全部由 scripts/build_fpk.py 重新生成，不入库）
build/

# 前端构建产物（vite build --mode fpk 可重新生成；由 build_fpk.py 组包时复制）
frontend/dist/

# 后端运行时数据与本地配置（SQLite 库/健康报告/真实密钥；.env.example 模板入库）
backend/data/
backend/.env

# Windows 资源管理器杂物（非源码，勿入库）
Thumbs.db
desktop.ini

# 构建产物 fpk（仅作 GitHub Release 资产，不入库；由 build.sh 重新生成）
nasdeck.fpk
nasdeck-release-*.fpk

# 论坛发帖草稿等杂物（非源码）
forum_post_*
forum_reply_*

sample_report.html

# macOS 资源分叉文件（非源码，勿入库）
.DS_Store
nasdeck-fnpack-*.fpk

# 历史验证截图 / 临时核查表（自测产物，不进仓库）
_verify_*.png
优化核查表_2026-08-20.md

# 真机目检截图（自测产物，不进仓库）
shots/

# Vue 工程依赖（本地安装，不入库；用 pnpm install 还原）
frontend/node_modules/
frontend/.vite/

# ZCode 工作区工具目录（本机环境，不入库）
.zcode/

# 前端截图自检工作区与 IDE
.smoke/
.idea/

# Mimosa 安全扫描插件状态（本机工具产物，不入库）
.mimosa/

# 整洁架构重构期原目录备份（安全网，不入库；git 历史为正式基线）
backend_backup_*

# 界面原型自检截图（自测产物，不进仓库；原型本体为 nasdeck-wireframe.html）
prototype/_shots/

# 整洁架构重构归档（backup_manifest.md 为清单基线）
backup/
