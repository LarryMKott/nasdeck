# fnOS FPK 打包构建（scripts/build_fpk.py 以 `vite build --mode fpk` 使用）
# 页面经飞牛 cgi 反代打开：/cgi/ThirdParty/com.dashboard.nasdeck/index.cgi/
# base 与接口基址必须带完整反代前缀：history 路由刷新后浏览器才能按绝对路径
# 命中反代下的资源；index.html 之外的路由由后端 SPA 回退返回（NASDECK_STATIC_DIR）。
VITE_APP_ENV=production

VITE_PUBLIC_PATH=/cgi/ThirdParty/com.dashboard.nasdeck/index.cgi/

# 全局 axios 基址（auth/dashboard/system 模块）；nas 数据层自带 index.cgi 前缀自适应
VITE_APP_BASE_API=/cgi/ThirdParty/com.dashboard.nasdeck/index.cgi/api

# 打包构建不启用 Mock、不生成 Gzip（FastAPI StaticFiles 不消费 .gz，白占包体）
VITE_USE_MOCK=false
VITE_BUILD_GZIP=false
