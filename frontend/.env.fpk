# fnOS FPK 打包构建（scripts/build_fpk.py 以 `vite build --mode fpk` 使用）
# 双访问模型单 dist：vite base 用 /__ND_PREFIX__ 占位符构建，后端 statics 挂载时按
# NASDECK_PUBLIC_PATH（cmd/main 按访问模型导出：CGI 形态 = 完整反代前缀，网关形态 =
# /app/com.dashboard.nasdeck）一次性替换落盘。index.html 之外的路由由后端 SPA 回退
# 返回（NASDECK_STATIC_DIR）；JS 侧接口基址不烤前缀，由 client.js apiBase() 运行时
# 按 location.pathname 自适应（index.cgi 标记或网关前缀）。
VITE_APP_ENV=production

VITE_PUBLIC_PATH=/__ND_PREFIX__/

# 全局 axios 基址（脚手架 auth/dashboard/system 模块遗留；nas 数据层经 client.js
# apiBase() 运行时自适应，不消费本值）——与 PUBLIC_PATH 同占位符，静置不参与替换
VITE_APP_BASE_API=/__ND_PREFIX__/api

# 打包构建不启用 Mock、不生成 Gzip（FastAPI StaticFiles 不消费 .gz，白占包体）
VITE_BUILD_GZIP=false
