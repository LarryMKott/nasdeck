# nasdeck 后端环境变量（全部 NASDECK_ 前缀，复制为 .env 使用）

# HTTP 端口
NASDECK_PORT=8766

# 监听地址：缺省仅回环（无鉴权形态暴露全网卡会把杀进程/控风扇的接口开放到局域网）；
# 需要局域网访问时改 0.0.0.0 并强烈建议同时设置 API Key
NASDECK_HOST=127.0.0.1

# API Key（留空则不校验 X-API-Key；绑定非回环地址时建议设置）
NASDECK_API_KEY=

# 代理共享密钥（FPK 形态由 install_callback 自动生成，开发/直连形态留空）
NASDECK_PROXY_TOKEN=

# SQLite（aiosqlite）；相对路径相对 backend/ 运行目录
NASDECK_DB_URL=sqlite+aiosqlite:///data/nasdeck.db

# 原始采样保留分钟数（超过后降采样为 1m 聚合点）
NASDECK_RAW_KEEP_MINUTES=120

# storcli 可执行文件路径（留空则从 PATH 探测）
NASDECK_STORCLI_PATH=

# 前端 dist 目录（FPK 打包形态由后端托管 SPA；留空不挂载）
NASDECK_STATIC_DIR=

# 日志级别
NASDECK_LOG_LEVEL=INFO
